{
  "name": "gehna-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "medusa develop",
    "build": "medusa build",
    "start": "npm run migrate && node scripts/start-production.mjs",
    "migrate": "medusa db:migrate",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --require ts-node/register/transpile-only --test tests/operations.test.cjs tests/phone.test.cjs tests/email.test.cjs tests/assistant.test.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@medusajs/admin-sdk": "2.21.1",
    "@medusajs/cli": "2.21.1",
    "@medusajs/framework": "2.21.1",
    "@medusajs/medusa": "2.21.1",
    "@medusajs/ui": "4.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "lodash": "4.18.1",
    "uuid": "11.1.1",
    "ajv": "8.20.0"
  }
}
