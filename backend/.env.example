DATABASE_URL=postgres://gehna:CHANGE_ME@127.0.0.1:15432/gehna_store
REDIS_URL=
STORE_CORS=http://localhost:3000,http://127.0.0.1:3000,https://gehnadesigns.in,https://www.gehnadesigns.in
ADMIN_CORS=http://localhost:9000,http://127.0.0.1:9000,https://api.gehnadesigns.in
AUTH_CORS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:9000,http://127.0.0.1:9000,https://gehnadesigns.in,https://www.gehnadesigns.in,https://api.gehnadesigns.in
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
COOKIE_SECRET=REPLACE_WITH_RANDOM_SECRET
STOREFRONT_URL=http://localhost:3000
MEDUSA_BACKEND_URL=http://localhost:9000
SEED_SAMPLE_CATALOG=true
STANDARD_SHIPPING_RATE_INR=80
WAREHOUSE_ADDRESS_LINE_1=
WAREHOUSE_CITY=
WAREHOUSE_STATE=
WAREHOUSE_POSTAL_CODE=

# Durable production image storage (S3 or compatible). Keep the bucket private/public policy consistent with S3_FILE_URL.
S3_BUCKET=
S3_REGION=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Transactional order/booking emails: verified sender domain at Resend.
RESEND_API_KEY=
ORDER_EMAIL_FROM=Gehna <rajesh@gehnadesigns.in>

# Twilio Verify SMS. The local preview code below works only in development.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PHONE_VERIFY_LOCAL=false

# Shiprocket API user: Settings > API > Add New API User (not the main account login).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PIN=
AUTO_SHIP=false
# Enable only when parcels are ready for collection automatically after booking.
SHIPROCKET_AUTO_PICKUP=false
# Actual packed weight in grams; leave blank only when all variants have measured weights.
SHIPMENT_WEIGHT_GRAMS=
PACKAGING_WEIGHT_GRAMS=0
SHIPMENT_LENGTH_CM=
SHIPMENT_BREADTH_CM=
SHIPMENT_HEIGHT_CM=
PRODUCT_HSN=
# Exact extra trusted storage hostname if Shiprocket changes its PDF host. No wildcards.
SHIPROCKET_PDF_HOSTS=
